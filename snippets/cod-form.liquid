<div id="codModal" class="cod-modal">
  <div class="cod-modal-content">
    <div class="cod-modal-header">
      <div class="modal-header-content">
        <div class="modal-icon">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#4caf50" stroke-width="2">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </div>
        <div>
          <h2>Complete Your Order</h2>
          <p>Cash on Delivery - Pay when you receive</p>
        </div>
      </div>
      <button class="close-modal" id="closeModal">&times;</button>
    </div>

    <div class="cod-modal-body">

      <!-- Progress Steps -->
      <div class="order-steps">
        <div class="step active">
          <div class="step-number">1</div>
          <span>Your Details</span>
        </div>
        <div class="step-line"></div>
        <div class="step">
          <div class="step-number">2</div>
          <span>Confirmation</span>
        </div>
        <div class="step-line"></div>
        <div class="step">
          <div class="step-number">3</div>
          <span>Delivery</span>
        </div>
      </div>

      <!-- Order Summary Card -->
      <div class="order-summary-card">
        <div class="order-product-info">
          <img src="" alt="" id="orderProductImage" class="order-product-img">
          <div class="order-product-details">
            <p class="order-product-name" id="orderProductName">Product Name</p>
            <p class="order-product-qty">Qty: <span id="orderQuantity">1</span></p>
          </div>
          <div class="order-product-price">
            <p class="order-price-label">Total</p>
            <p class="order-price-value" id="orderPrice">$0.00</p>
          </div>
        </div>
        <div class="order-benefits">
          <div class="benefit-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4caf50" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Free Delivery
          </div>
          <div class="benefit-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4caf50" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            No Payment Now
          </div>
          <div class="benefit-item">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#4caf50" stroke-width="2.5">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            30-Day Returns
          </div>
        </div>
      </div>

      <form id="codForm" class="cod-form">
        <input type="hidden" id="productId" name="product_id">
        <input type="hidden" id="productVariant" name="variant_id">

        <div class="form-section-header">
          <h3>📍 Where should we deliver?</h3>
          <p>Fill in your details below - we'll contact you to confirm</p>
        </div>

        <div class="form-section">
          <div class="form-group-enhanced">
            <label for="fullName">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
              Full Name <span class="required">*</span>
            </label>
            <input type="text" id="fullName" name="full_name" required placeholder="John Doe" autocomplete="name">
          </div>

          <div class="form-group-enhanced">
            <label for="phoneNumber">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
              </svg>
              Phone Number <span class="required">*</span>
            </label>
            <input type="tel" id="phoneNumber" name="phone" required placeholder="+1 234 567 8900" autocomplete="tel">
            <small>We'll call you to confirm your order</small>
          </div>

          <div class="form-group-enhanced">
            <label for="email">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                <polyline points="22,6 12,13 2,6"></polyline>
              </svg>
              Email Address (Optional)
            </label>
            <input type="email" id="email" name="email" placeholder="john@example.com" autocomplete="email">
            <small>For order updates and tracking</small>
          </div>

          <div class="form-group-enhanced">
            <label for="address">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
                <polyline points="9 22 9 12 15 12 15 22"></polyline>
              </svg>
              Street Address <span class="required">*</span>
            </label>
            <textarea id="address" name="address" required placeholder="Building number, Street name, Apartment/Unit" rows="2" autocomplete="street-address"></textarea>
          </div>

          <div class="form-row">
            <div class="form-group-enhanced">
              <label for="city">City <span class="required">*</span></label>
              <input type="text" id="city" name="city" required placeholder="City" autocomplete="address-level2">
            </div>

            <div class="form-group-enhanced">
              <label for="postalCode">Postal Code <span class="required">*</span></label>
              <input type="text" id="postalCode" name="postal_code" required placeholder="12345" autocomplete="postal-code">
            </div>
          </div>

          <div class="form-group-enhanced">
            <label for="region">State/Region <span class="required">*</span></label>
            <input type="text" id="region" name="region" required placeholder="State/Region" autocomplete="address-level1">
          </div>

          <div class="form-group-enhanced">
            <label for="notes">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                <polyline points="14 2 14 8 20 8"></polyline>
                <line x1="16" y1="13" x2="8" y2="13"></line>
                <line x1="16" y1="17" x2="8" y2="17"></line>
                <polyline points="10 9 9 9 8 9"></polyline>
              </svg>
              Special Instructions (Optional)
            </label>
            <textarea id="notes" name="notes" placeholder="e.g., Call before delivery, Leave at door" rows="2"></textarea>
          </div>
        </div>

        <div class="payment-info-enhanced">
          <div class="payment-method-card">
            <div class="payment-icon">
              <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#f57224" stroke-width="2">
                <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                <line x1="1" y1="10" x2="23" y2="10"></line>
              </svg>
            </div>
            <div class="payment-details">
              <h4>💵 Cash on Delivery</h4>
              <p>Pay when you receive your order</p>
              <ul class="payment-features">
                <li>✓ No prepayment required</li>
                <li>✓ Inspect before paying</li>
                <li>✓ 100% secure</li>
              </ul>
            </div>
          </div>
        </div>

        <div class="form-actions-enhanced">
          <button type="submit" class="btn-confirm-order">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
            Confirm Order - Pay on Delivery
          </button>
          <button type="button" class="btn-cancel-link" id="cancelOrder">Cancel</button>
          <p class="form-note">By placing your order, you agree to our terms and conditions</p>
        </div>
      </form>

      <div id="orderSuccess" class="order-success-enhanced" style="display: none;">
        <div class="success-animation">
          <div class="success-checkmark">
            <svg width="80" height="80" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="10" fill="#4caf50"/>
              <polyline points="8 12 11 15 16 9" stroke="#fff" stroke-width="2.5" stroke-linecap="round"/>
            </svg>
          </div>
        </div>
        <h3>🎉 Order Confirmed!</h3>
        <p class="success-message">Thank you! Your order has been successfully placed.</p>
        <div class="order-details-box">
          <p class="order-number-text">Order Number:</p>
          <p class="order-number-value" id="orderNumber">#123456</p>
        </div>
        <div class="success-info">
          <div class="info-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4caf50" stroke-width="2">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <div>
              <strong>We'll call you soon</strong>
              <p>To confirm your order and delivery</p>
            </div>
          </div>
          <div class="info-item">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#4caf50" stroke-width="2">
              <path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path>
              <polyline points="13 2 13 9 20 9"></polyline>
            </svg>
            <div>
              <strong>Delivery in 2-5 days</strong>
              <p>Free shipping included</p>
            </div>
          </div>
        </div>
        <button class="btn-continue-shopping" onclick="location.href='/'">
          Continue Shopping
        </button>
      </div>
    </div>
  </div>
</div>
