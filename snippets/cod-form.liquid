<div id="codModal" class="cod-modal">
  <div class="cod-modal-content">
    <div class="cod-modal-header">
      <h2>Cash on Delivery Order</h2>
      <button class="close-modal" id="closeModal">&times;</button>
    </div>

    <div class="cod-modal-body">
      <div class="order-summary">
        <h3>Order Summary</h3>
        <div class="order-item">
          <div class="item-details">
            <p class="item-name" id="orderProductName">Product Name</p>
            <p class="item-quantity">Quantity: <span id="orderQuantity">1</span></p>
          </div>
          <div class="item-price">
            <p id="orderPrice">$0.00</p>
          </div>
        </div>
        <div class="order-total">
          <span>Total Amount:</span>
          <span class="total-price" id="orderTotal">$0.00</span>
        </div>
      </div>

      <form id="codForm" class="cod-form">
        <input type="hidden" id="productId" name="product_id">
        <input type="hidden" id="productVariant" name="variant_id">

        <div class="form-section">
          <h3>Delivery Information</h3>

          <div class="form-group">
            <label for="fullName">Full Name <span class="required">*</span></label>
            <input type="text" id="fullName" name="full_name" required placeholder="Enter your full name">
          </div>

          <div class="form-group">
            <label for="phoneNumber">Phone Number <span class="required">*</span></label>
            <input type="tel" id="phoneNumber" name="phone" required placeholder="Enter your phone number">
          </div>

          <div class="form-group">
            <label for="email">Email Address</label>
            <input type="email" id="email" name="email" placeholder="Enter your email (optional)">
          </div>

          <div class="form-group">
            <label for="address">Complete Address <span class="required">*</span></label>
            <textarea id="address" name="address" required placeholder="House/Building number, Street name" rows="2"></textarea>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="city">City <span class="required">*</span></label>
              <input type="text" id="city" name="city" required placeholder="City">
            </div>

            <div class="form-group">
              <label for="postalCode">Postal Code <span class="required">*</span></label>
              <input type="text" id="postalCode" name="postal_code" required placeholder="Postal Code">
            </div>
          </div>

          <div class="form-group">
            <label for="region">State/Region <span class="required">*</span></label>
            <input type="text" id="region" name="region" required placeholder="State/Region">
          </div>

          <div class="form-group">
            <label for="notes">Order Notes (Optional)</label>
            <textarea id="notes" name="notes" placeholder="Any special instructions for delivery" rows="3"></textarea>
          </div>
        </div>

        <div class="payment-info">
          <div class="payment-method">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M20 8H4V6h16v2zm0 2H4v6h16v-6zM4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" fill="#f57224"/>
            </svg>
            <div>
              <strong>Cash on Delivery</strong>
              <p>Pay when you receive your order</p>
            </div>
          </div>
        </div>

        <div class="form-actions">
          <button type="button" class="btn btn-cancel" id="cancelOrder">Cancel</button>
          <button type="submit" class="btn btn-confirm">Confirm Order</button>
        </div>
      </form>

      <div id="orderSuccess" class="order-success" style="display: none;">
        <div class="success-icon">✓</div>
        <h3>Order Placed Successfully!</h3>
        <p>Your order has been confirmed. We'll contact you shortly to confirm delivery details.</p>
        <p class="order-number">Order Number: <strong id="orderNumber"></strong></p>
        <button class="btn btn-primary" onclick="location.href='/'">Continue Shopping</button>
      </div>
    </div>
  </div>
</div>
