<section class="flash-sale-section">
  <div class="container">
    <div class="flash-sale-header">
      <div class="flash-sale-title">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
          <path d="M13 2L3 14h8l-1 8 10-12h-8l1-8z" fill="currentColor"/>
        </svg>
        <h2>{{ section.settings.title | default: "⚡ Flash Sale" }}</h2>
      </div>
      {% if section.settings.show_timer %}
        <div class="flash-sale-timer" id="flashTimer">
          <span class="timer-label">Ends in:</span>
          <div class="timer-display">
            <span class="timer-unit">
              <span class="timer-hours">02</span>
              <span class="timer-text">h</span>
            </span>
            <span class="timer-sep">:</span>
            <span class="timer-unit">
              <span class="timer-minutes">00</span>
              <span class="timer-text">m</span>
            </span>
            <span class="timer-sep">:</span>
            <span class="timer-unit">
              <span class="timer-seconds">00</span>
              <span class="timer-text">s</span>
            </span>
          </div>
        </div>
      {% endif %}
    </div>

    <div class="flash-sale-products">
      {% if section.settings.collection != blank %}
        {% assign flash_products = collections[section.settings.collection].products %}
      {% else %}
        {% assign flash_products = collections.all.products %}
      {% endif %}

      {% if flash_products.size > 0 %}
        {% for product in flash_products limit: section.settings.products_to_show %}
          <div class="flash-sale-card">
            <a href="{{ product.url }}" class="flash-sale-link">
              <div class="flash-sale-image">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | img_url: '300x300' }}" alt="{{ product.title }}" loading="lazy">
                {% else %}
                  <div class="flash-sale-placeholder">
                    <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="#e0e0e0" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                      <circle cx="8.5" cy="8.5" r="1.5"></circle>
                      <polyline points="21 15 16 10 5 21"></polyline>
                    </svg>
                  </div>
                {% endif %}
                {% if product.compare_at_price and product.compare_at_price > product.price %}
                  {% assign flash_discount = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | floor %}
                  <span class="flash-sale-badge">-{{ flash_discount }}%</span>
                {% endif %}
              </div>
              <div class="flash-sale-info">
                <h3 class="flash-sale-product-title">{{ product.title }}</h3>
                <div class="flash-sale-pricing">
                  <span class="flash-sale-price">{{ product.price | money }}</span>
                  {% if product.compare_at_price and product.compare_at_price > product.price %}
                    <span class="flash-sale-original">{{ product.compare_at_price | money }}</span>
                  {% endif %}
                </div>
                <div class="flash-sale-stock">
                  <div class="stock-bar">
                    <div class="stock-fill" style="width: {{ section.settings.stock_level | default: 65 }}%"></div>
                  </div>
                  <p class="stock-text">🔥 Almost Gone!</p>
                </div>
              </div>
            </a>
          </div>
        {% endfor %}
      {% else %}
        <div class="flash-sale-empty">
          <p>No products in flash sale yet. Check back soon!</p>
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Flash Sale",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "⚡ Flash Sale"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 3,
      "max": 12,
      "step": 1,
      "label": "Products to Show",
      "default": 6
    },
    {
      "type": "checkbox",
      "id": "show_timer",
      "label": "Show Countdown Timer",
      "default": true
    },
    {
      "type": "range",
      "id": "stock_level",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Stock Level Indicator",
      "default": 65
    }
  ],
  "presets": [
    {
      "name": "Flash Sale"
    }
  ]
}
{% endschema %}
