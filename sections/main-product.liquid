<!-- Minimal Product Page - Testing -->
<div class="product-page" style="padding: 40px 20px; max-width: 1200px; margin: 0 auto;">

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px;">

    <!-- Product Image -->
    <div>
      {% if product.featured_image %}
        <img src="{{ product.featured_image | img_url: '600x600' }}" alt="{{ product.title }}" style="width: 100%; border-radius: 8px;">
      {% else %}
        <div style="background: #f5f5f5; padding: 100px; text-align: center; border-radius: 8px;">
          No Image
        </div>
      {% endif %}
    </div>

    <!-- Product Details -->
    <div>
      <h1 style="font-size: 32px; margin-bottom: 20px;">{{ product.title }}</h1>

      <div style="font-size: 36px; color: #f57224; font-weight: bold; margin-bottom: 20px;">
        {{ product.price | money }}
      </div>

      {% if product.description != blank %}
        <div style="margin-bottom: 30px; line-height: 1.6;">
          {{ product.description }}
        </div>
      {% endif %}

      <button
        id="orderNowBtn"
        data-product-id="{{ product.id }}"
        data-product-title="{{ product.title }}"
        data-product-price="{{ product.price }}"
        data-product-image="{{ product.featured_image | img_url: '200x200' }}"
        style="background: linear-gradient(135deg, #f57224 0%, #ff8c42 100%); color: white; padding: 16px 40px; border: none; border-radius: 8px; font-size: 18px; font-weight: bold; cursor: pointer; width: 100%;">
        Order Now - Cash on Delivery
      </button>

      <p style="text-align: center; margin-top: 15px; color: #666;">
        ✓ Free Delivery • ✓ Pay When You Receive
      </p>
    </div>

  </div>

</div>

{% schema %}
{
  "name": "Product",
  "settings": []
}
{% endschema %}
