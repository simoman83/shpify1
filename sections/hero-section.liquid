<section class="hero-section">
  <div class="hero-slider">
    {% if section.settings.background_image %}
      <div class="hero-slide" style="background-image: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.3)), url({{ section.settings.background_image | img_url: '1920x' }})">
    {% else %}
      <div class="hero-slide" style="background: linear-gradient(135deg, #f57224 0%, #ff8c42 100%)">
    {% endif %}
      <div class="container">
        <div class="hero-content">
          <h1>{{ section.settings.title | default: "Welcome to " | append: shop.name }}</h1>
          <p>{{ section.settings.subtitle | default: "Discover amazing products with free delivery" }}</p>
          {% if section.settings.button_text != blank %}
            <a href="{{ section.settings.button_link | default: '/collections/all' }}" class="btn btn-hero">
              {{ section.settings.button_text }}
            </a>
          {% else %}
            <a href="/collections/all" class="btn btn-hero">Shop Now</a>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Welcome to Our Store"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Discover amazing products"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}
