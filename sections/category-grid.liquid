<section class="category-grid-section">
  <div class="container">
    <div class="section-header">
      <h2>{{ section.settings.title | default: "Shop by Category" }}</h2>
    </div>

    <div class="category-grid">
      {% if section.blocks.size > 0 %}
        {% for block in section.blocks %}
          <a href="{{ block.settings.link | default: '/collections/all' }}" class="category-item" {{ block.shopify_attributes }}>
            <div class="category-icon">
              {% if block.settings.image %}
                <img src="{{ block.settings.image | img_url: '150x150' }}" alt="{{ block.settings.title }}" loading="lazy">
              {% else %}
                <div class="category-icon-placeholder">
                  <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
                    <line x1="7" y1="2" x2="7" y2="22"></line>
                    <line x1="17" y1="2" x2="17" y2="22"></line>
                    <line x1="2" y1="12" x2="22" y2="12"></line>
                    <line x1="2" y1="7" x2="7" y2="7"></line>
                    <line x1="2" y1="17" x2="7" y2="17"></line>
                    <line x1="17" y1="17" x2="22" y2="17"></line>
                    <line x1="17" y1="7" x2="22" y2="7"></line>
                  </svg>
                </div>
              {% endif %}
            </div>
            <span class="category-name">{{ block.settings.title | default: "Category" }}</span>
          </a>
        {% endfor %}
      {% else %}
        {%  comment %} Default categories - link to search for now to avoid 404s {% endcomment %}
        {% assign default_categories = "Electronics,Fashion,Home & Living,Beauty,Sports,Toys,Books,Health" | split: "," %}
        {% for category in default_categories limit: 8 %}
          <a href="/search?q={{ category | url_encode }}" class="category-item">
            <div class="category-icon">
              <div class="category-icon-placeholder">
                <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect>
                </svg>
              </div>
            </div>
            <span class="category-name">{{ category }}</span>
          </a>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category Grid",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Section Title",
      "default": "Shop by Category"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Category Name",
          "default": "Category"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category Image"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category Grid",
      "blocks": [
        {
          "type": "category",
          "settings": {
            "title": "Electronics"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Fashion"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Home & Living"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Beauty"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Sports"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Toys & Kids"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Books"
          }
        },
        {
          "type": "category",
          "settings": {
            "title": "Health"
          }
        }
      ]
    }
  ]
}
{% endschema %}
